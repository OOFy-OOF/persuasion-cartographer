{
  "manifest_version": 3,
  "name": "Persuasion Cartographer",
  "version": "0.1.0",
  "description": "Map rhetorical techniques in selected text while you browse.",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": ["https://persuasioncartographer.duckdns.org/*"],
  "action": {
    "default_title": "Analyze selected text",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
